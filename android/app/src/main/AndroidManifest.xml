<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.NFC_NDEF" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- The settings "Update" area checks the public GitHub releases page
         for a newer build (the app is sideloaded - there is no store). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The settings "Update" area installs the downloaded release APK
         through the platform's own installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- NFC is the whole point of the app, but the app still opens without it. -->
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <application
        android:name=".LumiApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="lumi"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        tools:targetApi="35">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Only matters for tags tapped while the app is closed or
                 starting: while the main page is open, tags arrive via the
                 activity's always-listening foreground dispatch instead.
                 The TECH_DISCOVERED filter requires its tech-list meta-data
                 or the framework never matches it. -->
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@array/nfc_tech_list" />
        </activity>

        <service
            android:name=".player.PlayerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Exposes the settings "Update" area's downloaded release APK to
             the platform's installer (the FileProvider uri the install
             intent carries; the paths file names the app's internal
             updates/ folder the download lands in). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.update.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_provider_paths" />
        </provider>

        <!-- The "Auto-lock after idle" setting's device admin: a normal app
             cannot lock the screen (DEVICE_POWER is signature|privileged),
             so the platform's consent + activation screen runs against this
             receiver, and the lock goes through DevicePolicyManager.lockNow
             while the admin is active. -->
        <receiver
            android:name=".device.LumiDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
