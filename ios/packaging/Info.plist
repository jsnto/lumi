<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>Lumi</string>
	<key>CFBundleIdentifier</key>
	<string>com.lumi.player</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>lumi</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Background-capable audio playback (feature 5): the app keeps
	     playing while the screen is locked / the app is backgrounded.
	     CoreNFC reads do NOT happen while backgrounded (a platform
	     limit) - a tag re-read on the return to the foreground resumes;
	     the audio itself is unaffected. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- CoreNFC (feature 4): the always-listening tag scan. iOS requires
	     this usage description or the app crashes on the first session. -->
	<key>NSNFCReaderUsageDescription</key>
	<string>lumi reads NFC tags so you can start, pause, and resume music by tapping a tag against your iPhone - the same way the Android app does.</string>
	<!-- An iPhone app: arm64 devices with an NFC reader (feature 4's
	     hardware requirement, the Android manifest's nfc capability). -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>nfc</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- The default launch screen (a plain background, no storyboard). -->
	<key>UILaunchScreen</key>
	<dict/>
	<key>MinimumOSVersion</key>
	<string>16.0</string>
</dict>
</plist>
